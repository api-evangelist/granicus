                  schema: |-
                    {
                      "$schema": "http://json-schema.org/draft-04/schema#",
                      "title": "SMS Statistics",
                      "description": "SMS Messages Statistics",
                      "type": "object",
                      "items": {
                        "body": {
                          "recipients": {
                            "new": {
                              "description": "The count of recipients in new status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "sending": {
                              "description": "The count of recipients in sending status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "inconclusive": {
                              "description": "The count of recipients in inconclusive status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "blacklisted": {
                              "description": "The count of recipients in blacklisted status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "canceled": {
                              "description": "The count of recipients in canceled status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "sent": {
                              "description": "The count of recipients in sent status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            },
                            "failed": {
                              "description": "The count of recipients in failed status associated with sms messages over the time period",
                              "type": "integer",
                              "example": "1"
                            }
                          }
                        }
                      }
                    }
                  example: |
                    {
                      "recipients": {
                        "new": 1,
                        "sending": 5,
                        "inconclusive": 0,
                        "blacklisted": 2,
                        "canceled": 0,
                        "sent": 50,
                        "failed": 1
                      }
                    }
            '422':
              body:
                application/json:
                  example: |
                    {
                      "error": "Invalid date parameters. start must be in a valid datetime format."
                    }
            '401': *1
          securedBy:
          - Authentication Token
          headers:
            X-AUTH-TOKEN: *2
"/deactivated_phone_numbers":
  description: Use this endpoint to return phone numbers deactivated on a specified
    date.
  get:
    description: "<p>When an individual deactivates their phone number that number
      is then put back into circulation and eventually given to a new owner by the
      carrier.</p>\n\n<p>This  can result in the new owner of the number receiving
      unwanted text message alerts or phone calls that the previous owner had opted
      into.  To \nhelp prevent this, carriers provide regular updates of phone numbers
      that have recently been deactivated so that those numbers can be removed from
      \nany alerts they previously opted into.</p>\n\n<p>TMS provides an easy way
      to obtain a list of phone numbers reported as deactivated for a given date.
      This information can then be used to update \nyour internal records and remove
      deactivated numbers (until the new owner of the number opts into receiving messages).\nPlease
      note that this endpoint provides all phone numbers reported as deactivated by
      the carrier for a given date and will include phone numbers you \nhave not sent
      to prior.</p>\n"
    queryParameters:
      date:
        description: |
          <p>Date for deactivated numbers selection (past dates only).
          Must be YYYY-MM-DD date format.</p>
        type: date
        required: true
        example: "/deactivated_phone_numbers?date=2021-11-28"
        displayName: date
    responses:
      '200':
        body:
          text/csv:
            example: |
              15075551212
              16125551234
              17155559876
              12135554561
      '401': *1
    protocols:
    - HTTPS
    securedBy:
    - Authentication Token
    headers:
      X-AUTH-TOKEN: *2
