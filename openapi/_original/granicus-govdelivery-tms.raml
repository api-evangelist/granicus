                      <li>Required: No</li>
                      <li>Id of the from address to associate to the template.</li>
                    </ul>
                  </li>
                </ul>
              type: string
              required: false
              example: |
                {
                  "from_address": "1"
                }
              displayName: _links
      responses:
        '200':
          body:
            application/json:
              schema: |-
