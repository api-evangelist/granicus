                        "type": "string",
                        "example": "2013-01-30T17:45:27Z"
                      },
                      "_links": {
                        "title": "Relational Links",
                        "description": "An object that defines links to related objects.",
                        "type": "object",
                        "properties": {
                          "self": {
                            "description": "Relative URI of the object",
                            "type": "string",
                            "example": "/keywords/1/commands/1"
                          },
                          "keyword": {
